# NEXUS Phase 1 - local development
# Copy to .env. Never commit a real .env; secrets come from the secret manager
# in every deployed environment (SDD 10.2).

NEXUS_ENV=local
NEXUS_LOG_LEVEL=INFO

# sqlite for local/test; postgres via docker-compose
NEXUS_DATABASE_URL=sqlite+aiosqlite:///./nexus.db
# NEXUS_DATABASE_URL=postgresql+asyncpg://nexus:nexus@localhost:5432/nexus

NEXUS_REDIS_URL=redis://localhost:6379/0

# The role the service connects as. It must not be a superuser and must not own
# the tables - either bypasses the ACL that makes audit_record append-only, and
# revision 0001 refuses to run rather than apply a control that does nothing.
# Migrations run as a separate owner role.
NEXUS_DB_APP_ROLE=nexus_app

# Model provider. "echo" is the deterministic local adapter - no network, no
# cost. Set to "anthropic" for real reasoning.
NEXUS_MODEL_PROVIDER=echo
NEXUS_FRONTIER_MODEL=claude-opus-5
NEXUS_SMALL_MODEL=claude-haiku-4-5

# The API key is NOT read from this file into application config - the SDK
# resolves it from the environment directly, so it cannot reach a log line, a
# prompt, or the trace. Export it in your shell:
#   export ANTHROPIC_API_KEY=sk-ant-...

# Budgets (SDD 9.6)
NEXUS_BUDGET_WALL_CLOCK_MS=300000
NEXUS_BUDGET_TOOL_CALLS=25
NEXUS_BUDGET_PLAN_STEPS=15
NEXUS_BUDGET_REPLANS=2
NEXUS_BUDGET_TOKENS_IN=150000
NEXUS_BUDGET_TOKENS_OUT=20000
NEXUS_TOOL_FANOUT=4

# Retention (doc 08 / ADR-11)
NEXUS_RETENTION_RAW_PAYLOAD_DAYS=30
NEXUS_RETENTION_EVIDENCE_DAYS=90
NEXUS_RETENTION_TRACE_DAYS=365

# Kill switch (SDD 8.4)
NEXUS_DISABLED=false
